# Technical scaffold configuration; no services or credentials required.
APP_ENV=development
# Required only when APP_ENV=production; set an explicit http(s) origin.
# APP_ORIGIN=http://localhost:3000
# F2 uses no app env credentials. Run pnpm db:f2:start <synthetic-target-id>.
# The wrapper reads local CLI status into memory; never paste its keys here.

# F3 Auth is opt-in. Public values below are intentionally included in the browser build.
# Set APP_ORIGIN to the same canonical origin as NEXT_PUBLIC_APP_ORIGIN.
# HTTPS is required except exact loopback hosts. No paths/query/credentials/wildcards.
# NEXT_PUBLIC_AUTH_ENABLED=true
# NEXT_PUBLIC_APP_ORIGIN=https://127.0.0.1:3143
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56521
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-legacy-anon-key-only>
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# NEXT_PUBLIC_AUTH_LOCAL_TEST=true
# Local-test flag is loopback-only; signup/recovery policies for public use remain OPEN.
# pnpm test:auth:f3 provisions all synthetic configuration in memory.
# Never place service-role keys in NEXT_PUBLIC_* or commit local credentials.
