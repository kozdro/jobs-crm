          "value": "((\"recruitment_case_event\".\"kind\" = 'application' AND \"recruitment_case_event\".\"direction\" IS NULL) OR (\"recruitment_case_event\".\"kind\" = 'contact' AND \"recruitment_case_event\".\"direction\" IS NOT NULL AND \"recruitment_case_event\".\"direction\" IN ('inbound', 'outbound'))) AND \"recruitment_case_event\".\"stage_name\" IS NULL AND \"recruitment_case_event\".\"previous_stage\" IS NULL AND \"recruitment_case_event\".\"expected_stage_version\" IS NULL OR (\"recruitment_case_event\".\"kind\" IN ('invitation', 'stage-change') AND \"recruitment_case_event\".\"direction\" IS NULL AND \"recruitment_case_event\".\"stage_name\" IS NOT NULL AND char_length(\"recruitment_case_event\".\"stage_name\") BETWEEN 1 AND 160 AND \"recruitment_case_event\".\"stage_name\" = public.recruitment_trim(\"recruitment_case_event\".\"stage_name\") AND \"recruitment_case_event\".\"expected_stage_version\" IS NOT NULL AND \"recruitment_case_event\".\"expected_stage_version\" BETWEEN 0 AND 2147483646 AND (\"recruitment_case_event\".\"previous_stage\" IS NULL OR (char_length(\"recruitment_case_event\".\"previous_stage\") BETWEEN 1 AND 160 AND \"recruitment_case_event\".\"previous_stage\" = public.recruitment_trim(\"recruitment_case_event\".\"previous_stage\"))))"
