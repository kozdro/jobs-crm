{
  "name": "jobs-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.22.2",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "next typegen && tsc --noEmit && tsc -p tsconfig.f2.json",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check src tests scripts experiments db *.ts *.mjs package.json components.json pnpm-workspace.yaml .prettierrc.json .github/workflows/app-ci.yml",
    "format:write": "prettier --write src tests scripts experiments db *.ts *.mjs package.json components.json pnpm-workspace.yaml .prettierrc.json .github/workflows/app-ci.yml",
    "test:unit": "vitest run && node --test scripts/db/*.test.ts scripts/auth/*.test.ts scripts/recruitment/*.test.ts scripts/local-dev/*.test.ts",
    "test:boundaries": "node scripts/test-boundaries.mjs",
    "test:canary": "node scripts/test-canary.mjs",
    "build": "next build",
    "start": "next start",
    "test:e2e:foundation": "playwright test --project=foundation",
    "ui": "shadcn",
    "db:f2:start": "node scripts/db/cli.ts start",
    "db:f2:stop": "node scripts/db/cli.ts stop",
    "db:f2:migrate": "node scripts/db/cli.ts migrate",
    "db:f2:preflight": "node scripts/db/cli.ts preflight",
    "test:integration:f2": "node --test --test-concurrency=1 tests/integration/rls/f2.test.ts",
    "test:auth:f3": "node scripts/auth/runner.ts",
    "test:recruitment": "node scripts/recruitment/runner.ts",
    "dev:local": "node scripts/local-dev/cli.ts start",
    "dev:local:stop": "node scripts/local-dev/cli.ts stop",
    "dev:local:reset": "node scripts/local-dev/cli.ts reset",
    "dev:local:status": "node scripts/local-dev/cli.ts status"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.32",
    "postgres": "3.4.8",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
